# Copy this file to .env.local and fill in your credentials.
# DO NOT commit .env.local — it is gitignored.
#
# Obtain Google OAuth client IDs from:
#   https://console.cloud.google.com/ → APIs & Services → Credentials
#
# Create three OAuth 2.0 Client IDs:
#   1. Android client (package name: com.aura.app)
#   2. iOS client (bundle ID: com.aura.app)
#   3. Web client (authorized redirect URI: https://auth.expo.io/@<your-expo-username>/aura-ui)

EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
